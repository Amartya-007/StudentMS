<Window x:Class="StudentMS.UI.Views.Fees.FeesFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:StudentMS.UI.Converters"
        Title="Fees Management"
        Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
    </Window.Resources>

    <!-- MAIN CARD -->
    <Border Margin="12"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesignCardBackground}"
            md:ElevationAssist.Elevation="Dp3">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Padding="18"
                    Background="#5E35B1"
                    CornerRadius="10,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <md:PackIcon Kind="CurrencyUsd"
                                 Width="22"
                                 Height="22"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>

                    <!-- Titles -->
                    <StackPanel Grid.Column="1">

                        <!-- Static + Dynamic -->
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White">
                            <Run Text="Fees"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding FormTitle}"/>
                        </TextBlock>

                        <!-- Subtitle -->
                        <TextBlock Text="Add or update student fee record"
                                   FontSize="12"
                                   Foreground="#D1C4E9"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY -->
            <StackPanel Grid.Row="1" Margin="24,20,24,10">

                <!-- Student -->
                <TextBlock Text="Student"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Margin="2,0,0,4"/>

                <ComboBox ItemsSource="{Binding Students}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="StudentId"
                          SelectedValue="{Binding StudentId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Select student"
                          Margin="0,0,0,16"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Amount -->
                <TextBlock Text="Amount"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Margin="2,0,0,4"/>

                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Enter amount (e.g. 3500)"
                         Margin="0,0,0,12"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Error -->
                <Border Padding="10"
                        CornerRadius="6"
                        Background="#FDECEA"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AlertCircle"
                                     Foreground="#D32F2F"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="#B71C1C"/>
                    </StackPanel>
                </Border>

                <!-- Busy -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <md:PackIcon Kind="Loading"
                                 Width="18"
                                 Height="18"
                                 Foreground="#5E35B1"/>
                    <TextBlock Text="Processing..."
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                </StackPanel>

            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Padding="16"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MaterialDesignCardBackground}">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="18,8"
                            Margin="0,0,8,0"/>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="20,8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>