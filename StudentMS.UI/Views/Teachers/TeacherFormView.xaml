<Window x:Class="StudentMS.UI.Views.Teachers.TeacherFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:StudentMS.UI.Converters"
        Title="Teacher Management"
        Height="440" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
    </Window.Resources>

    <!-- MAIN CARD -->
    <Border Margin="12"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesignCardBackground}"
            md:ElevationAssist.Elevation="Dp3">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Padding="18"
                    Background="#5E35B1"
                    CornerRadius="10,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <md:PackIcon Kind="AccountTie"
                                 Width="22"
                                 Height="22"
                                 Foreground="White"
                                 Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1">

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White">
                            <Run Text="Teacher"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding FormTitle}"/>
                        </TextBlock>

                        <TextBlock Text="Add or update teacher details"
                                   FontSize="12"
                                   Foreground="#D1C4E9"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY -->
            <StackPanel Grid.Row="1" Margin="24,20,24,10">

                <!-- SECTION TITLE -->
                <TextBlock Text="Basic Information"
                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           Margin="0,0,0,12"/>

                <!-- NAME -->
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Full Name"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- PHONE -->
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Phone Number"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- DEPARTMENT -->
                <ComboBox ItemsSource="{Binding Departments}"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentId"
                          SelectedValue="{Binding DepartmentId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Department"
                          Margin="0,0,0,12"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- ERROR -->
                <Border Padding="10"
                        CornerRadius="6"
                        Background="#FDECEA"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AlertCircle"
                                     Foreground="#D32F2F"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#B71C1C"/>
                    </StackPanel>
                </Border>

                <!-- BUSY -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <md:PackIcon Kind="Loading"
                                 Width="18"
                                 Height="18"
                                 Foreground="#5E35B1"/>
                    <TextBlock Text="Saving..."
                               Margin="8,0,0,0"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                </StackPanel>

            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    Padding="16"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MaterialDesignCardBackground}">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="18,8"
                            Margin="0,0,8,0"/>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="20,8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>