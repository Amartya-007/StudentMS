<Window x:Class="StudentMS.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:StudentMS.UI.Converters"
        Title="Student Management System — Login"
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter             x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
        <converters:BoolToPackIconKindConverter      x:Key="BoolToPackIcon"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>   <!-- Dark header -->
            <RowDefinition Height="*"/>     <!-- White card -->
        </Grid.RowDefinitions>

        <!-- ── Dark purple header ──────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#4527A0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <md:PackIcon Kind="School"
                             Width="48" Height="48"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10"/>
                <TextBlock Text="StudentMS"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Student Management System"
                           FontSize="12"
                           Foreground="#B39DDB"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── White login card ────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="0,0,4,4"
                Margin="32,-1,32,32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,28">

                    <!-- Section title -->
                    <TextBlock Text="Sign In"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#212121"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your credentials to continue"
                               FontSize="13" Foreground="#757575"
                               Margin="0,0,0,24"/>

                    <!-- ── Username ──────────────────────────────────── -->
                    <TextBlock Text="Username" FontSize="12"
                               Foreground="#616161" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Enter your username"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="#212121"
                             Margin="0,0,0,2"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Text="{Binding UsernameError}"
                               Foreground="#C62828" FontSize="11"
                               Margin="2,2,0,10"
                               Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibility}}"/>

                    <!-- ── Password ──────────────────────────────────── -->
                    <TextBlock Text="Password" FontSize="12"
                               Foreground="#616161" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Masked PasswordBox -->
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="0"
                                     md:HintAssist.Hint="Enter your password"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Foreground="#212121"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                     Visibility="{Binding ShowPassword,
                                                  Converter={StaticResource BoolToVisibility},
                                                  ConverterParameter=Inverse}"/>

                        <!-- Plain TextBox (show password mode) -->
                        <TextBox x:Name="PlainPasswordBox"
                                 Grid.Column="0"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="Enter your password"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="#212121"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                 Visibility="{Binding ShowPassword,
                                              Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Eye toggle -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleShowPasswordCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="#757575"
                                ToolTip="Show / hide password"
                                Margin="6,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <md:PackIcon Kind="{Binding ShowPassword,
                                         Converter={StaticResource BoolToPackIcon}}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding PasswordError}"
                               Foreground="#C62828" FontSize="11"
                               Margin="2,2,0,10"
                               Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibility}}"/>

                    <!-- ── Error banner ──────────────────────────────── -->
                    <Border Background="#FFEBEE"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AlertCircle"
                                         Foreground="#C62828"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#C62828"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Login button ──────────────────────────────── -->
                    <Button Content="LOGIN"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#512DA8"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            Height="46"
                            FontSize="14" FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                    <!-- ── Busy indicator ────────────────────────────── -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
