<Window x:Class="StudentMS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Student Management System"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>

        <!-- ── Sidebar nav button — pure WPF, no MD override ──────────────── -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="HorizontalAlignment"      Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                  Value="24,14"/>
            <Setter Property="Margin"                   Value="0,1"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="#4527A0">
            <DockPanel>

                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,28,0,20"
                            HorizontalAlignment="Center">
                    <md:PackIcon Kind="School"
                                 Width="38" Height="38"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,8"/>
                    <TextBlock Text="StudentMS"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle DockPanel.Dock="Top"
                           Height="1" Fill="#55FFFFFF"
                           Margin="16,0,16,16"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">

                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Students">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountSchool" Width="18" Height="18"
                                         Foreground="White" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Students" Foreground="White"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Teachers">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountTie" Width="18" Height="18"
                                         Foreground="White" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Teachers" Foreground="White"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Departments">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Domain" Width="18" Height="18"
                                         Foreground="White" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Departments" Foreground="White"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Fees">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CurrencyUsd" Width="18" Height="18"
                                         Foreground="White" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                            <TextBlock Text="Fees" Foreground="White"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content area ────────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#512DA8">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">
                    <md:PackIcon Kind="ViewDashboard"
                                 Foreground="White"
                                 Width="18" Height="18"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="16" FontWeight="Medium"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Page content -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
