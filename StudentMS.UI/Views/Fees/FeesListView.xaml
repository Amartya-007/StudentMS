<UserControl x:Class="StudentMS.UI.Views.Fees.FeesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StudentMS.UI.Converters"
             Background="{DynamicResource MaterialDesignPaper}"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Padding="20"
                Margin="0,0,0,16"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp2">

            <DockPanel LastChildFill="False">

                <StackPanel>
                    <TextBlock Text="Fees"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

                    <TextBlock Text="Track student fee payments"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Add Fee"
                        Command="{Binding AddFeeCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="18,8"
                        Visibility="{Binding ActionVisibility}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </DockPanel>
        </Border>

        <!-- FILTER CARD -->
        <Border Grid.Row="1"
                Padding="16"
                Margin="0,0,0,12"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp1">

            <StackPanel Orientation="Horizontal">

                <ComboBox ItemsSource="{Binding Students}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="StudentId"
                          SelectedValue="{Binding FilterStudentId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="All Students"
                          Width="220"
                          Margin="0,0,12,0"/>

                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding FilterStatus}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Status"
                          Width="140"
                          Margin="0,0,12,0"/>

                <Button Content="Search"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="18,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>

        <!-- MESSAGES -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">

            <Border Padding="12"
                    CornerRadius="6"
                    Background="#FDECEA"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AlertCircle" Foreground="#D32F2F" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    CornerRadius="6"
                    Background="#EDF7ED"
                    Margin="0,8,0,0"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="CheckCircle" Foreground="#2E7D32" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SuccessMessage}"/>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- DATA GRID -->
        <Border Grid.Row="3"
                Padding="8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp2">

            <DataGrid ItemsSource="{Binding Fees}"
                      SelectedItem="{Binding SelectedFee}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      md:DataGridAssist.CellPadding="16 8"
                      md:DataGridAssist.ColumnHeaderPadding="16 10"
                      RowHeight="48">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding FeeId}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Student"
                                        Binding="{Binding StudentName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Amount"
                                        Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                        Width="120"/>

                    <!-- STATUS CHIP -->
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,3"
                                        CornerRadius="12"
                                        HorizontalAlignment="Left">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#F57F17"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Paid On"
                                        Binding="{Binding PaidDate, StringFormat=dd/MM/yyyy}"
                                        Width="120"/>

                    <!-- ACTION -->
                    <DataGridTemplateColumn Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button Content="Mark Paid"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4"
                                        Foreground="#2E7D32"
                                        Command="{Binding DataContext.MarkPaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding FeeId}"
                                        Visibility="{Binding DataContext.ActionVisibility,
                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>