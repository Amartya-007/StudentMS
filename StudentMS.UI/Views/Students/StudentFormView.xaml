<Window x:Class="StudentMS.UI.Views.Students.StudentFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:StudentMS.UI.Converters"
        Title="{Binding FormTitle}"
        Height="580" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter             x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Colored header -->
            <RowDefinition Height="*"/>     <!-- Form fields -->
            <RowDefinition Height="Auto"/>  <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ── Colored header strip ─────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#512DA8" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="AccountEdit" Foreground="White"
                             Width="24" Height="24"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding FormTitle}"
                           FontSize="17" FontWeight="Medium"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Form fields ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">

                <!-- Full Name -->
                <TextBlock Text="Full Name *" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Enter full name"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#212121"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Date of Birth -->
                <TextBlock Text="Date of Birth" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DateOfBirth}"
                            md:HintAssist.Hint="dd/MM/yyyy"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Foreground="#212121"
                            Margin="0,0,0,16"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Gender -->
                <TextBlock Text="Gender" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding Gender}"
                          md:HintAssist.Hint="Select gender"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="#212121"
                          Margin="0,0,0,16"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Phone -->
                <TextBlock Text="Phone" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="e.g. 03001234567"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#212121"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Address -->
                <TextBlock Text="Address" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Enter address"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#212121"
                         AcceptsReturn="True" Height="72"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Department -->
                <TextBlock Text="Department *" FontSize="12" Foreground="#616161" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Departments}"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentId"
                          SelectedValue="{Binding DepartmentId}"
                          md:HintAssist.Hint="Select department"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="#212121"
                          Margin="0,0,0,8"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <!-- Error -->
                <Border Background="#FFEBEE" CornerRadius="4" Padding="12,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AlertCircle" Foreground="#C62828" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#616161"
                        Padding="20,8" Margin="0,0,10,0"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="24,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
