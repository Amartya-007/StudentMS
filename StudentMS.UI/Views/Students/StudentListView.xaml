<UserControl x:Class="StudentMS.UI.Views.Students.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:StudentMS.UI.Converters"
             Background="{DynamicResource MaterialDesignPaper}"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Padding="20"
                Margin="0,0,0,16"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp2">

            <DockPanel LastChildFill="False">

                <StackPanel>
                    <TextBlock Text="Students"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

                    <TextBlock Text="Manage student records"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Add Student"
                        Command="{Binding AddStudentCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="18,8"
                        Visibility="{Binding ActionVisibility}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </DockPanel>
        </Border>

        <!-- FILTER CARD -->
        <Border Grid.Row="1"
                Padding="16"
                Margin="0,0,0,12"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp1">

            <StackPanel Orientation="Horizontal">

                <ComboBox ItemsSource="{Binding Departments}"
                          DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentId"
                          SelectedValue="{Binding FilterDepartmentId}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="All Departments"
                          Width="220"
                          Margin="0,0,12,0"/>

                <Button Content="Search"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="18,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                <Button Content="Clear"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="12,8"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>

        <!-- MESSAGES -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">

            <Border Padding="12"
                    CornerRadius="6"
                    Background="#FDECEA"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AlertCircle" Foreground="#D32F2F" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    CornerRadius="6"
                    Background="#EDF7ED"
                    Margin="0,8,0,0"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="CheckCircle" Foreground="#2E7D32" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SuccessMessage}"/>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- DATA GRID -->
        <Border Grid.Row="3"
                Padding="8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                md:ElevationAssist.Elevation="Dp2">

            <DataGrid ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      md:DataGridAssist.CellPadding="16 8"
                      md:DataGridAssist.ColumnHeaderPadding="16 10"
                      RowHeight="48"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding StudentId}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Department"
                                        Binding="{Binding DepartmentName}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Gender"
                                        Binding="{Binding Gender}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="140"/>

                    <DataGridTextColumn Header="DOB"
                                        Binding="{Binding DOB, StringFormat=dd/MM/yyyy}"
                                        Width="120"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding DataContext.ActionVisibility,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}">

                                    <Button Style="{StaticResource MaterialDesignToolButton}"
                                            Command="{Binding DataContext.EditStudentCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <md:PackIcon Kind="Pencil" Foreground="#5E35B1"/>
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignToolButton}"
                                            Command="{Binding DataContext.DeleteStudentCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding StudentId}">
                                        <md:PackIcon Kind="Delete" Foreground="#D32F2F"/>
                                    </Button>

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>